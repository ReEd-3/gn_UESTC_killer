<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- [修复 2026-10-19] 引擎需要联网做打卡/查询：
         此前漏掉该权限 → 巡检全部报 "Permission denied (missing INTERNET permission?)"，到点不打卡 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- [v6] 电池优化引导（重装后系统会重置该设置，被限制会影响定时触发） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- [v6] 向主应用上报运行事件：接收方挂的是该签名级权限，发送方需持有（同签名自动授予） -->
    <uses-permission android:name="com.gnuestc.checkin.permission.CONTROL_ENGINE" />

    <!-- [修复 2026-10-18] 包可见性：允许引擎查询主应用
         （Android 11+ 默认查不到其它应用；否则 getLaunchIntentForPackage 返回 null，通知点击无反应） -->
    <queries>
        <package android:name="com.gnuestc.checkin" />
    </queries>

    <!-- 控制权限（签名级）：只有同一签名的主应用才能给引擎发指令 -->
    <permission
        android:name="com.gnuestc.checkin.permission.CONTROL_ENGINE"
        android:protectionLevel="signature" />

    <!-- [2026-10-21] 应用图标：AS Image Asset 已生成到本模块；此前未在 manifest 声明 → 显示系统默认机器人 -->
    <!-- [review 2026-10-21] 应用名与主应用保持一致：通知栏/系统设置里展示的就是"这个 App"，
         避免用户看到"后台组件"这种内部用语（原值：晚安成电-后台组件） -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 安装后由主应用拉起一次：解除"新安装应用"的 stopped 状态 + 申请通知权限；
             半透明、不入最近任务，用户几乎无感
             [v15] 去掉 noHistory：跳转系统设置后必须能"返回复检并继续引导"
             （离开页面由 onStop 自行结束，不会残留） -->
        <activity
            android:name=".BootstrapActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.gnuestc.checkin.permission.CONTROL_ENGINE"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 控制指令接收器（仅主应用可调用；支持投递给"已安装未启动"的应用）
             [修复 2026-10-18] "指定包名+动作"的广播必须靠 intent-filter 才能匹配投递；
             此前缺此配置，导致所有指令（ping/sync/测试闹钟）静默丢失 -->
        <receiver
            android:name=".EngineReceiver"
            android:exported="true"
            android:permission="com.gnuestc.checkin.permission.CONTROL_ENGINE">
            <intent-filter>
                <action android:name="com.gnuestc.checkin.engine.action.CMD" />
            </intent-filter>
        </receiver>

        <!-- 闹钟触发接收器（仅引擎内部 PendingIntent 可达） -->
        <receiver
            android:name=".EngineAlarmReceiver"
            android:exported="false" />

        <!-- [v7 巡检链] 巡检点接收器（仅引擎内部 PendingIntent 可达）；
             窗口内每 5 分钟一环、链式自续：任何一次被系统放行即可完成打卡 -->
        <receiver
            android:name=".EnginePatrolReceiver"
            android:exported="false" />

        <!-- [保活 2026-10-22] 会话心跳接收器（仅引擎内部 PendingIntent 可达）；
             全天候每 30 分钟发一次只读 /today，避免会话在窗口外静置失效 -->
        <receiver
            android:name=".EngineHeartbeatReceiver"
            android:exported="false" />

        <!-- [双包 2026-10-18] 引擎自己的常驻前台服务：
             放在引擎里才有意义——主应用被划掉不影响它 -->
        <service
            android:name=".EngineKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep daily check-in scheduled task reliable" />
        </service>
    </application>
</manifest>
