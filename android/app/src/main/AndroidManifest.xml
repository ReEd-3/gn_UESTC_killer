<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- [双包 2026-10-18] 安装内嵌的「后台组件（引擎）」 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 控制引擎的签名级权限（仅同一签名的主应用可发送指令） -->
    <uses-permission android:name="com.gnuestc.checkin.permission.CONTROL_ENGINE" />

    <!-- [修复 2026-10-18] 包可见性：允许主应用查询「后台组件（引擎）」（否则 Android 11+ 上 getPackageInfo 查不到） -->
    <queries>
        <package android:name="com.gnuestc.checkin.engine" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GNCheckin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内嵌 WebView 完成 SSO 登录并捕获会话 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- 地图选点（内置 Leaflet + 高德瓦片，仅应用内调用） -->
        <activity
            android:name=".MapPickActivity"
            android:exported="false" />

        <!-- [新增 2026-10-18] 常驻前台服务：低优先级常驻通知，降低被系统静默回收的概率 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep check-in scheduled task reliable" />
        </service>

        <!-- 闹钟触发的打卡执行器，仅通过应用内 PendingIntent 调用 -->
        <receiver
            android:name=".CheckinReceiver"
            android:exported="false" />

        <!-- 开机重建闹钟；BOOT_COMPLETED 是受保护广播，只有系统能发出 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- [双包 2026-10-18] 供系统安装器读取内嵌引擎 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
